{
  "name": "bukit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BUKIT — la red social para cumplir tus objetivos (TFG)",
  "author": "Liviu Deleanu",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --filter \"!@bukit/e2e\" test",
    "test:e2e": "pnpm --filter @bukit/e2e test",
    "web:dev": "pnpm --filter @bukit/web dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:migrate": "pnpm --filter @bukit/api db:migrate",
    "db:studio": "pnpm --filter @bukit/api db:studio",
    "db:seed": "pnpm --filter @bukit/api db:seed",
    "docs:pdf": "cd docs/thesis && latexmk",
    "docs:clean": "cd docs/thesis && latexmk -C"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.1"
  }
}
