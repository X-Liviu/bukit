// Esquema de datos de BUKIT.
// Un solo Postgres cubre grafo social (relaciones nativas), mapa (PostGIS) y
// afinidad (pgvector).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Extensiones ya decididas (son infraestructura, no modelo de datos): mapa + afinidad.
  extensions = [postgis, vector]
}

// ── MODELOS DE DATOS ─────────────────────────────────────────────────────────
// Diseño incremental: cada entidad se acuerda CON el autor antes de escribirse
// aquí (regla del proyecto), y pasa su revisión de minimización (riesgo R7):
// cada dato personal con su finalidad declarada; lo que hoy no tiene finalidad,
// no se almacena (ni teléfono, ni fecha de nacimiento, ni ubicación; los campos
// de verificación de identidad llegarán con su épica y serán solo estado +
// clave de referencia del proveedor, nunca la imagen del documento).

// CRITERIOS DE MODELO fijados con la primera entidad (revisión del 09-08-2026,
// acordados con el autor; documentados en el cap. 9):
// - Nombres de BD en snake_case vía @map/@@map: hay SQL crudo comprometido
//   (PostGIS, pgvector) y los identificadores camelCase de Prisma exigirían
//   comillas dobles exactas en cada consulta (Postgres pliega a minúsculas).
// - Fechas SIEMPRE con zona horaria (@db.Timestamptz): los plazos de metas y
//   las caducidades (60 días / 24 h) no pueden depender del TimeZone de la
//   sesión del servidor.
// - Longitudes máximas respaldadas en columna (defensa en profundidad: la
//   normalización vive en el Zod compartido, pero la BD acota el tamaño).
// - Ids generados también en BD (gen_random_uuid, nativa en PG13+): un INSERT
//   fuera del cliente Prisma no debe romperse por falta de default.

// Dos niveles de usuario (regla de producto): NORMAL, con menor peso en el
// feed; TOP, creador admitido por un proceso externo, con vídeo y mayor peso.
// Sin endpoint para cambiarlo: la admisión TOP no es autoservicio.
enum UserTier {
  NORMAL
  TOP

  @@map("user_tier")
}

// Cuenta de usuario (US-04, acordada con el autor el 07-08-2026; reforzada en
// la revisión del 09-08-2026). Finalidad de cada dato: email = identificación
// y acceso (normalizado a minúsculas en el esquema Zod compartido antes de
// llegar aquí); passwordHash = autenticación (solo el hash bcrypt: la
// contraseña en claro jamás se persiste); username = identidad pública del
// perfil; tier = ponderación del feed.
// UUID como id: no enumerable (nadie recorre /users/1,2,3...) y tipo nativo de
// Postgres. Descartados: BIGINT autoincremental (enumerable, revela volumen) y
// cuid (se almacena como texto, sin tipo nativo).
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  username     String   @unique @db.VarChar(30)
  tier         UserTier @default(NORMAL)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

// Token de refresco persistido (US-06; diseño propuesto el 16-08 y el 04-10,
// aprobado por el autor el 10-10-2026). Hasta la US-05 el refresco era un JWT
// sin estado: válido 30 días y sin forma de anularlo. Guardarlo permite
// rotarlo en cada uso, cerrar sesión de verdad y detectar robos.
// Finalidad de cada dato: tokenHash = reconocer el token presentado (solo su
// huella SHA-256: un volcado de la base no regala sesiones; SHA-256 y no
// bcrypt porque el token ya es largo y aleatorio, no hay nada que «estirar»);
// familyId = agrupar un inicio de sesión con todas sus renovaciones, para
// que ante una reutilización se anule SOLO esa sesión (decisión del autor del
// 10-10: las demás sesiones del usuario, en otros dispositivos, siguen
// vivas); expiresAt = caducidad, igual a la del JWT; revokedAt = anulación
// sin borrar (la fila anulada es la prueba de una reutilización);
// replacedById = qué token lo sustituyó al rotar.
// Minimización (R7): sin IP, dispositivo ni navegador; ninguna función
// comprometida los necesita.
// Alternativas descartadas: anular todas las sesiones del usuario ante una
// reutilización (expulsa también a sus dispositivos legítimos) y una entidad
// Session aparte (más normalizada, pero una tabla sin función propia hoy).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  // Borrado en cascada (criterio del cap. 9): las sesiones dependen de su
  // cuenta y no tienen valor propio; borrar la cuenta (derecho de supresión)
  // se lleva sus sesiones sin limpieza manual.
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RotacionDeTokens", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RotacionDeTokens")

  // (userId, expiresAt): la purga de caducados del propio usuario al iniciar
  // sesión (opción A, decisión del autor del 10-10). familyId: anular una
  // sesión entera ante una reutilización o un cierre de sesión.
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
