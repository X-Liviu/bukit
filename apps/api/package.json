{
  "name": "@bukit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor / API de BUKIT (Node + Prisma). Framework HTTP pendiente de decidir.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bukit/core": "workspace:*",
    "@prisma/client": "6.1.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "prisma": "6.1.0",
    "tsx": "4.19.2"
  }
}
