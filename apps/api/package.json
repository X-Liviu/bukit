{
  "name": "@bukit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor / API de BUKIT (Node + Express 5 + Prisma).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bukit/core": "workspace:*",
    "@prisma/client": "6.1.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "9.0.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "tsx": "4.23.15",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "6.1.0",
    "supertest": "7.2.2",
    "vitest": "5.0.3"
  }
}
