# Copia este archivo a `.env` (que está gitignorado) y ajusta si hace falta.
# Coincide con las credenciales del docker-compose de desarrollo.
DATABASE_URL="postgresql://bukit:bukit@localhost:5432/bukit?schema=public"

# Puerto de la API en desarrollo.
PORT=3001

# En producción, DATABASE_URL apunta a Neon (región UE): su valor vive fuera del
# repositorio (panel de Render, secreto DATABASE_URL_PRODUCTION de GitHub y
# .env.production local, ignorado por git). No se commitea nunca.

# IP real del cliente para la limitación de peticiones (US-07): solo en Render,
# donde el Blueprint fija cf-connecting-ip. En local no se define: cuenta la IP
# del socket.
# CLIENT_IP_HEADER="cf-connecting-ip"

# Secreto de firma de los tokens JWT (mínimo 32 caracteres). En local puede
# omitirse (hay uno de desarrollo); en producción lo genera Render (Blueprint).
# JWT_SECRET="cadena-aleatoria-de-al-menos-32-caracteres"
