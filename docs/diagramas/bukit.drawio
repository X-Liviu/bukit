<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Claude Code" version="24.0.0"><diagram id="1Clasesmodelodedatoshoy" name="1. Clases: modelo de datos (hoy)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de clases UML 2.5: el modelo de datos de hoy (04-10-2026)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="360" height="182" as="geometry"/></mxCell><mxCell id="v3" value="id : UUID {id}&lt;br&gt;email : String {size ≤ 254}&lt;br&gt;username : String {size ≤ 30}&lt;br&gt;passwordHash : String&lt;br&gt;tier : UserTier = NORMAL&lt;br&gt;createdAt : DateTime&lt;br&gt;updatedAt : DateTime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v2"><mxGeometry x="0" y="30" width="360" height="152" as="geometry"/></mxCell><mxCell id="v4" value="&amp;laquo;enumeration&amp;raquo;&lt;br&gt;&lt;b&gt;UserTier&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="200" height="98" as="geometry"/></mxCell><mxCell id="v5" value="NORMAL&lt;br&gt;TOP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v4"><mxGeometry x="0" y="46" width="200" height="52" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v2" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="{email único}&lt;br&gt;{username único}" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9e9e9e;" edge="1" parent="1" source="v7" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;Qué representa &lt;i&gt;User&lt;/i&gt;&lt;/b&gt;&lt;br&gt;Las cuentas de usuario. Se guarda en la tabla &lt;b&gt;users&lt;/b&gt; (columnas en minúsculas con guion bajo: &lt;i&gt;password_hash&lt;/i&gt;, &lt;i&gt;created_at&lt;/i&gt;…).&lt;br&gt;• La rellena &lt;b&gt;POST /auth/register&lt;/b&gt;, la consulta &lt;b&gt;POST /auth/login&lt;/b&gt; y la lee &lt;b&gt;GET /auth/me&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;id&lt;/b&gt; es un UUID: nadie puede recorrer perfiles probando números.&lt;br&gt;• &lt;b&gt;email&lt;/b&gt; y &lt;b&gt;username&lt;/b&gt; se guardan en minúsculas (lo hace el Zod de &lt;i&gt;packages/core&lt;/i&gt;).&lt;br&gt;• De la contraseña solo se guarda el &lt;b&gt;hash&lt;/b&gt; bcrypt; la API nunca lo devuelve.&lt;br&gt;• &lt;b&gt;tier&lt;/b&gt; no lo cambia ninguna ruta: el alta como TOP llega por un formulario externo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Todavía no hay asociaciones&lt;/b&gt;: es la única clase del modelo. La primera llega con la US-06 (página 2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="680" height="220" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Lo que la base tiene además y no es del modelo&lt;/b&gt; (por eso no se dibuja como clase):&lt;br&gt;• &lt;i&gt;_prisma_migrations&lt;/i&gt;: historial de migraciones de Prisma (hoy, una: 20260809110000_user_inicial).&lt;br&gt;• &lt;i&gt;spatial_ref_sys&lt;/i&gt; y las vistas &lt;i&gt;geometry_columns&lt;/i&gt; y &lt;i&gt;geography_columns&lt;/i&gt;: catálogos de PostGIS para el futuro mapa.&lt;br&gt;&lt;br&gt;&lt;b&gt;Motor y extensiones&lt;/b&gt; (iguales en local y en producción): PostgreSQL 16.15, PostGIS 3.3.10 y pgvector 0.8.0." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="420" height="200" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Rectángulo = &lt;b&gt;clase&lt;/b&gt;: arriba el nombre; debajo, los atributos «nombre : Tipo».&lt;br&gt;• &lt;b&gt;{id}&lt;/b&gt; = el atributo identifica cada objeto; &lt;b&gt;= NORMAL&lt;/b&gt; = valor por defecto.&lt;br&gt;• &lt;b&gt;{…}&lt;/b&gt; = restricción (en una nota o tras el atributo).&lt;br&gt;• &amp;laquo;enumeration&amp;raquo; = tipo con una lista cerrada de valores.&lt;br&gt;• Flecha discontinua = &lt;b&gt;dependencia&lt;/b&gt; (User usa el tipo UserTier).&lt;br&gt;• Nota con la esquina doblada = comentario; la línea discontinua la une al elemento." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="840" y="340" width="420" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2ClasespropuestaUS06" name="2. Clases: propuesta US-06"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de clases UML 2.5: propuesta para la US-06 (pendiente de tu OK el 05-10)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="320" height="182" as="geometry"/></mxCell><mxCell id="v3" value="id : UUID {id}&lt;br&gt;email : String {size ≤ 254}&lt;br&gt;username : String {size ≤ 30}&lt;br&gt;passwordHash : String&lt;br&gt;tier : UserTier = NORMAL&lt;br&gt;createdAt : DateTime&lt;br&gt;updatedAt : DateTime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v2"><mxGeometry x="0" y="30" width="320" height="152" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;RefreshToken&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="320" height="142" as="geometry"/></mxCell><mxCell id="v5" value="id : UUID {id}&lt;br&gt;tokenHash : String {size = 64}&lt;br&gt;expiresAt : DateTime&lt;br&gt;createdAt : DateTime&lt;br&gt;revokedAt : DateTime [0..1]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v4"><mxGeometry x="0" y="30" width="320" height="112" as="geometry"/></mxCell><mxCell id="e6" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v2" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l7" value="1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="14" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l8" value="0..*" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-26" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l9" value="sesiones" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-40" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=none;html=1;fontSize=12;edgeStyle=orthogonalEdgeStyle;endArrow=open;endSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="175"/><mxPoint x="1020" y="240"/></Array></mxGeometry></mxCell><mxCell id="l11" value="0..1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e10"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="14" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l12" value="0..1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e10"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="20" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l13" value="reemplazadoPor" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e10"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="48" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="v14" value="{tokenHash único}" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="160" height="40" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9e9e9e;" edge="1" parent="1" source="v14" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;En la base de datos&lt;/b&gt;&lt;br&gt;• La clase se guarda en la tabla &lt;b&gt;refresh_tokens&lt;/b&gt;.&lt;br&gt;• La &lt;b&gt;composición&lt;/b&gt; (rombo negro) se guarda como la columna &lt;i&gt;user_id&lt;/i&gt;: cada sesión pertenece a un usuario y, si se borra el usuario, sus sesiones se borran con él (ON DELETE CASCADE).&lt;br&gt;• &lt;b&gt;reemplazadoPor&lt;/b&gt; se guarda como &lt;i&gt;replaced_by_id&lt;/i&gt;: el token que sustituyó a este al renovarse.&lt;br&gt;• Del token solo se guarda su huella SHA-256 (&lt;i&gt;tokenHash&lt;/i&gt;), nunca el token. Sin IP ni dispositivo (minimización RGPD)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="560" height="190" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Cómo funcionaría&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Iniciar sesión&lt;/b&gt;: además de devolver los tokens, guarda la huella del de refresco.&lt;br&gt;• &lt;b&gt;POST /auth/refresh&lt;/b&gt; (nuevo): da un par nuevo, anula el anterior (&lt;i&gt;revokedAt&lt;/i&gt;) y lo enlaza con &lt;i&gt;reemplazadoPor&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;Reutilizar un token ya renovado&lt;/b&gt; = posible robo: se cierran todas las sesiones del usuario.&lt;br&gt;• &lt;b&gt;POST /auth/logout&lt;/b&gt; (nuevo): anula el token presentado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Decisiones tuyas&lt;/b&gt; (detalle en el diario del 04-10): el diseño, todas las sesiones o solo la cadena, y la purga de caducados." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="560" height="170" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;: rombo negro = &lt;b&gt;composición&lt;/b&gt; (las partes no existen sin el todo). Los números de los extremos son &lt;b&gt;multiplicidades&lt;/b&gt;: &lt;b&gt;1&lt;/b&gt; = exactamente uno; &lt;b&gt;0..*&lt;/b&gt; = ninguno o varios; &lt;b&gt;0..1&lt;/b&gt; = como mucho uno. &lt;b&gt;[0..1]&lt;/b&gt; en un atributo = opcional. La flecha abierta indica en qué sentido se navega la asociación. Amarillo discontinuo = propuesta que aún no existe." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1160" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3Despliegue" name="3. Despliegue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de despliegue UML 2.5: dónde se ejecuta cada pieza" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;Portátil del autor&lt;/b&gt; (Windows 11)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="380" as="geometry"/></mxCell><mxCell id="v3" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Node.js 24.18&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="100" as="geometry"/></mxCell><mxCell id="v4" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;apps/api&lt;/b&gt; (API en desarrollo, &lt;i&gt;pnpm dev&lt;/i&gt;, puerto 3001)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="205" width="310" height="45" as="geometry"/></mxCell><mxCell id="v5" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Docker Desktop&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="360" height="175" as="geometry"/></mxCell><mxCell id="v6" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;PostgreSQL 16.15&lt;/b&gt; (contenedor &lt;i&gt;bukit-db&lt;/i&gt;)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="320" height="110" as="geometry"/></mxCell><mxCell id="v7" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;base bukit&lt;/b&gt; (PostGIS 3.3.10, pgvector 0.8.0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="280" height="45" as="geometry"/></mxCell><mxCell id="e8" value="&amp;laquo;TCP&amp;raquo;" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.889;exitY=1;entryX=0.938;entryY=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;GitHub&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="360" height="380" as="geometry"/></mxCell><mxCell id="v10" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;repositorio bukit&lt;/b&gt; (rama main)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="300" height="45" as="geometry"/></mxCell><mxCell id="v11" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;GitHub Actions&lt;/b&gt; (runner Ubuntu)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="320" height="160" as="geometry"/></mxCell><mxCell id="v12" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;(lint, typecheck, pruebas, docker, migraciones)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="260" width="280" height="60" as="geometry"/></mxCell><mxCell id="v13" value="Dependabot propone aquí, cada semana, PRs de actualización." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="320" height="40" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Render&lt;/b&gt; (Fráncfort, plan gratuito)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="400" height="200" as="geometry"/></mxCell><mxCell id="v15" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Contenedor Docker&lt;/b&gt; (node:24.18-alpine)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="145" width="360" height="125" as="geometry"/></mxCell><mxCell id="v16" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;imagen bukit-api&lt;/b&gt; (apps/api)&lt;br&gt;https://bukit-api-07ph.onrender.com" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="195" width="310" height="60" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Neon&lt;/b&gt; (Fráncfort, plan gratuito)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="400" height="180" as="geometry"/></mxCell><mxCell id="v18" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;PostgreSQL 16.15&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="415" width="360" height="105" as="geometry"/></mxCell><mxCell id="v19" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;base bukit&lt;/b&gt; (PostGIS 3.3.10, pgvector 0.8.0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="310" height="45" as="geometry"/></mxCell><mxCell id="v20" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;Dispositivo del usuario&lt;/b&gt;&lt;br&gt;(hoy, cualquier cliente HTTP; más adelante, navegador y app)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="100" width="200" height="150" as="geometry"/></mxCell><mxCell id="e21" value="&amp;laquo;HTTPS&amp;raquo;&lt;br&gt;git push" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" parent="1" source="v2" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="&amp;laquo;HTTPS&amp;raquo;&lt;br&gt;commits y&lt;br&gt;estado de la CI" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.38;" edge="1" parent="1" source="v9" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="&amp;laquo;TCP/TLS&amp;raquo;&lt;br&gt;job&lt;br&gt;migraciones" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.294;" edge="1" parent="1" source="v9" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="&amp;laquo;TCP/TLS&amp;raquo; consultas" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v14" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="&amp;laquo;HTTPS&amp;raquo;" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.425;" edge="1" parent="1" source="v20" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v26" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Cubo = &lt;b&gt;nodo&lt;/b&gt;: una máquina o un servicio donde se ejecuta algo. &amp;laquo;device&amp;raquo; = dispositivo físico; &amp;laquo;executionEnvironment&amp;raquo; = entorno de ejecución dentro de un nodo.&lt;br&gt;• &amp;laquo;artifact&amp;raquo; = pieza concreta que se despliega (una imagen, una base, un archivo).&lt;br&gt;• Línea entre nodos = &lt;b&gt;ruta de comunicación&lt;/b&gt;, con su protocolo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Más adelante&lt;/b&gt; se añadirán nodos para la web (Vercel o Cloudflare Pages), el móvil (Expo/EAS) y los servicios externos (mensajería, imágenes, notificaciones push, verificación de identidad, IA, Redis)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="860" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4Actividaddeunpushaproduccin" name="4. Actividad: de un push a producción"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de actividad UML 2.5: cómo llega un cambio a producción" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Autor" style="swimlane;horizontal=1;startSize=30;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="820" as="geometry"/></mxCell><mxCell id="v3" value="GitHub Actions (CI)" style="swimlane;horizontal=1;startSize=30;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="640" height="820" as="geometry"/></mxCell><mxCell id="v4" value="Render" style="swimlane;horizontal=1;startSize=30;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="300" height="820" as="geometry"/></mxCell><mxCell id="v5" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="125" width="30" height="30" as="geometry"/></mxCell><mxCell id="v6" value="Subir cambios a main&lt;br&gt;(o actualizar una PR de Dependabot)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=12;