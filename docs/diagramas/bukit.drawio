<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Claude Code" version="24.0.0"><diagram id="1Clasesmodelodedatos" name="1. Clases: modelo de datos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de clases UML 2.5: el modelo de datos (10-10-2026, tras la US-06)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;User&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="320" height="182" as="geometry"/></mxCell><mxCell id="v3" value="id : UUID {id}&lt;br&gt;email : String {size ≤ 254}&lt;br&gt;username : String {size ≤ 30}&lt;br&gt;passwordHash : String&lt;br&gt;tier : UserTier = NORMAL&lt;br&gt;createdAt : DateTime&lt;br&gt;updatedAt : DateTime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v2"><mxGeometry x="0" y="30" width="320" height="152" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;RefreshToken&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="340" height="162" as="geometry"/></mxCell><mxCell id="v5" value="id : UUID {id}&lt;br&gt;familyId : UUID&lt;br&gt;tokenHash : String {size = 64}&lt;br&gt;expiresAt : DateTime&lt;br&gt;createdAt : DateTime&lt;br&gt;revokedAt : DateTime [0..1]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v4"><mxGeometry x="0" y="30" width="340" height="132" as="geometry"/></mxCell><mxCell id="e6" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v2" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l7" value="1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="14" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l8" value="0..*" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-24" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l9" value="refreshTokens" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e6"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-84" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=none;html=1;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="159"/><mxPoint x="1070" y="232"/></Array></mxGeometry></mxCell><mxCell id="l11" value="replaces  0..1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e10"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="46" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="l12" value="replacedBy  0..1" style="edgeLabel;resizable=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e10"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="50" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="v13" value="&amp;laquo;enumeration&amp;raquo;&lt;br&gt;&lt;b&gt;UserTier&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="200" height="98" as="geometry"/></mxCell><mxCell id="v14" value="NORMAL&lt;br&gt;TOP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="v13"><mxGeometry x="0" y="46" width="200" height="52" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.375;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="v2" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="{email único}&lt;br&gt;{username único}" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="320" y="360" width="150" height="56" as="geometry"/></mxCell><mxCell id="e17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9e9e9e;" edge="1" parent="1" source="v16" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="{tokenHash único}&lt;br&gt;{replacedBy único}" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="170" height="56" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9e9e9e;" edge="1" parent="1" source="v18" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;Qué representa cada clase&lt;/b&gt;&lt;br&gt;• &lt;b&gt;User&lt;/b&gt;: las cuentas. La rellena &lt;b&gt;POST /auth/register&lt;/b&gt;; &lt;b&gt;POST /auth/login&lt;/b&gt; comprueba la contraseña (de ella solo se guarda el &lt;b&gt;hash&lt;/b&gt; bcrypt) y &lt;b&gt;GET /auth/me&lt;/b&gt; la devuelve sin el hash. &lt;b&gt;email&lt;/b&gt; y &lt;b&gt;username&lt;/b&gt; se guardan en minúsculas (Zod de &lt;i&gt;packages/core&lt;/i&gt;); &lt;b&gt;tier&lt;/b&gt; no lo cambia ninguna ruta.&lt;br&gt;• &lt;b&gt;RefreshToken&lt;/b&gt; (US-06): cada token de refresco emitido. Del token solo se guarda su huella SHA-256 (&lt;b&gt;tokenHash&lt;/b&gt;), nunca el token. &lt;b&gt;familyId&lt;/b&gt; agrupa un inicio de sesión con todas sus renovaciones: es la «sesión». &lt;b&gt;expiresAt&lt;/b&gt; es la misma caducidad que lleva el JWT; &lt;b&gt;revokedAt&lt;/b&gt; marca la anulación sin borrar la fila (así se reconoce una reutilización); &lt;b&gt;replacedBy&lt;/b&gt; apunta al token que lo sustituyó al renovarse.&lt;br&gt;• Minimización (RGPD): sin IP, dispositivo ni navegador." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="900" height="150" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;En la base de datos&lt;/b&gt; (PostgreSQL 16.15, igual en local y en Neon)&lt;br&gt;• Tablas &lt;b&gt;users&lt;/b&gt; y &lt;b&gt;refresh_tokens&lt;/b&gt;, con nombres en minúsculas y guion bajo (&lt;i&gt;password_hash&lt;/i&gt;, &lt;i&gt;family_id&lt;/i&gt;…).&lt;br&gt;• La &lt;b&gt;composición&lt;/b&gt; es la columna &lt;i&gt;user_id&lt;/i&gt; con &lt;b&gt;ON DELETE CASCADE&lt;/b&gt;: al borrar una cuenta se borran sus sesiones.&lt;br&gt;• &lt;b&gt;replacedBy&lt;/b&gt; es la columna &lt;i&gt;replaced_by_id&lt;/i&gt; (única, &lt;b&gt;ON DELETE SET NULL&lt;/b&gt;).&lt;br&gt;• Índices: (&lt;i&gt;user_id&lt;/i&gt;, &lt;i&gt;expires_at&lt;/i&gt;) para borrar los caducados del usuario al iniciar sesión, y &lt;i&gt;family_id&lt;/i&gt; para anular una sesión entera.&lt;br&gt;• Además, fuera del modelo: &lt;i&gt;_prisma_migrations&lt;/i&gt; (2 migraciones: &lt;i&gt;user_inicial&lt;/i&gt; y &lt;i&gt;refresh_tokens&lt;/i&gt;) y los catálogos de PostGIS." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="460" height="230" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Rectángulo = &lt;b&gt;clase&lt;/b&gt;: nombre arriba y atributos «nombre : Tipo» debajo (sin operaciones: son datos).&lt;br&gt;• &lt;b&gt;{id}&lt;/b&gt; = identifica cada objeto; &lt;b&gt;= NORMAL&lt;/b&gt; = valor por defecto; &lt;b&gt;[0..1]&lt;/b&gt; = opcional.&lt;br&gt;• Rombo negro = &lt;b&gt;composición&lt;/b&gt;: los tokens no existen sin su usuario.&lt;br&gt;• Números en los extremos = &lt;b&gt;multiplicidades&lt;/b&gt; (1 = uno; 0..* = ninguno o varios; 0..1 = como mucho uno) y nombre del extremo (&lt;i&gt;refreshTokens&lt;/i&gt;, &lt;i&gt;replacedBy&lt;/i&gt;, &lt;i&gt;replaces&lt;/i&gt;).&lt;br&gt;• Flecha discontinua = &lt;b&gt;dependencia&lt;/b&gt;; &amp;laquo;enumeration&amp;raquo; = lista cerrada de valores.&lt;br&gt;• Nota = comentario o &lt;b&gt;{restricción}&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="460" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2Secuenciainiciarycerrarsesin" name="2. Secuencia: iniciar y cerrar sesión"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagramas de secuencia UML 2.5: iniciar y cerrar sesión (US-05 y US-06)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="v2" value="sd Iniciar sesión" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=150;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1020" height="440" as="geometry"/></mxCell><mxCell id="v3" value=":Cliente" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="120" width="140" height="380" as="geometry"/></mxCell><mxCell id="v4" value=":API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="140" height="380" as="geometry"/></mxCell><mxCell id="v5" value=":PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="140" height="380" as="geometry"/></mxCell><mxCell id="v6" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="575" y="175" width="10" height="300" as="geometry"/></mxCell><mxCell id="e7" value="POST /auth/login (email, contraseña)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="180" as="sourcePoint"/><mxPoint x="575" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v8" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="215" width="10" height="35" as="geometry"/></mxCell><mxCell id="e9" value="buscar el usuario por su email" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="220" as="sourcePoint"/><mxPoint x="945" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="usuario" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="248" as="sourcePoint"/><mxPoint x="585" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="268" as="sourcePoint"/><mxPoint x="585" y="286" as="targetPoint"/><Array as="points"><mxPoint x="625" y="268"/><mxPoint x="625" y="286"/></Array></mxGeometry></mxCell><mxCell id="v12" value="comprobar la contraseña (bcrypt)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="264" width="300" height="26" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="308" as="sourcePoint"/><mxPoint x="585" y="326" as="targetPoint"/><Array as="points"><mxPoint x="625" y="308"/><mxPoint x="625" y="326"/></Array></mxGeometry></mxCell><mxCell id="v14" value="firmar el par de tokens (JWT con jti aleatorio)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="304" width="300" height="26" as="geometry"/></mxCell><mxCell id="v15" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="360" width="10" height="52" as="geometry"/></mxCell><mxCell id="e16" value="transacción: borrar sus tokens caducados y&lt;br&gt;guardar la huella SHA-256 del nuevo (familia nueva)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="365" as="sourcePoint"/><mxPoint x="945" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="hecho" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="407" as="sourcePoint"/><mxPoint x="585" y="407" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="200 { user, tokens }" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="465" as="sourcePoint"/><mxPoint x="215" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v19" value="sd Cerrar sesión" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=140;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1020" height="400" as="geometry"/></mxCell><mxCell id="v20" value=":Cliente" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="600" width="140" height="340" as="geometry"/></mxCell><mxCell id="v21" value=":API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="600" width="140" height="340" as="geometry"/></mxCell><mxCell id="v22" value=":PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="140" height="340" as="geometry"/></mxCell><mxCell id="v23" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="575" y="655" width="10" height="260" as="geometry"/></mxCell><mxCell id="e24" value="POST /auth/logout (refreshToken)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="660" as="sourcePoint"/><mxPoint x="575" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="680" as="sourcePoint"/><mxPoint x="585" y="698" as="targetPoint"/><Array as="points"><mxPoint x="625" y="680"/><mxPoint x="625" y="698"/></Array></mxGeometry></mxCell><mxCell id="v26" value="verificar el JWT: firma, caducidad y tipo «refresh»" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="676" width="300" height="26" as="geometry"/></mxCell><mxCell id="v27" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="725" width="10" height="35" as="geometry"/></mxCell><mxCell id="e28" value="buscar el token por su huella" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="730" as="sourcePoint"/><mxPoint x="945" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e29" value="fila (con su familyId)" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="758" as="sourcePoint"/><mxPoint x="585" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v30" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="780" width="680" height="90" as="geometry"/></mxCell><mxCell id="v31" value="[existe la fila]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="392" y="808" width="420" height="20" as="geometry"/></mxCell><mxCell id="v32" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="825" width="10" height="35" as="geometry"/></mxCell><mxCell id="e33" value="anular toda su familia (revokedAt = ahora)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="830" as="sourcePoint"/><mxPoint x="945" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="hecho" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="856" as="sourcePoint"/><mxPoint x="585" y="856" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="204 (también si ya estaba cerrada)" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="905" as="sourcePoint"/><mxPoint x="215" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v36" value="&lt;b&gt;Qué añade la US-06&lt;/b&gt;&lt;br&gt;• Al &lt;b&gt;iniciar sesión&lt;/b&gt;, el token de refresco deja de ser un JWT «suelto»: se guarda su huella en una &lt;b&gt;familia&lt;/b&gt; nueva, que representa esta sesión. En la misma transacción se borran los tokens caducados del propio usuario (decisión del autor, opción A).&lt;br&gt;• &lt;b&gt;Cerrar sesión&lt;/b&gt; anula la familia entera, no solo el token presentado. Si la sesión ya estaba cerrada, responde igual (204): no delata el estado del token.&lt;br&gt;• Un JWT inválido, caducado o de acceso en lugar de refresco → &lt;b&gt;401&lt;/b&gt; (en los dos flujos)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="460" height="250" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Marco &lt;b&gt;sd&lt;/b&gt; = una interacción, con su nombre.&lt;br&gt;• Columna con línea discontinua = &lt;b&gt;línea de vida&lt;/b&gt; de un participante («:API» = un objeto de tipo API).&lt;br&gt;• Rectángulo estrecho = &lt;b&gt;activación&lt;/b&gt;: el participante está trabajando.&lt;br&gt;• Flecha continua con punta rellena = &lt;b&gt;mensaje síncrono&lt;/b&gt; (se espera respuesta); discontinua = &lt;b&gt;respuesta&lt;/b&gt;.&lt;br&gt;• Flecha que vuelve a la misma línea = el participante se envía un mensaje a sí mismo.&lt;br&gt;• Marco &lt;b&gt;opt&lt;/b&gt; = fragmento que solo ocurre si se cumple la &lt;b&gt;[condición]&lt;/b&gt;.&lt;br&gt;• El tiempo avanza hacia abajo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="460" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3Secuenciarenovarlasesin" name="3. Secuencia: renovar la sesión"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de secuencia UML 2.5: renovar la sesión con rotación (US-06)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="v2" value="sd Renovar la sesión" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=170;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1020" height="900" as="geometry"/></mxCell><mxCell id="v3" value=":Cliente" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="120" width="140" height="840" as="geometry"/></mxCell><mxCell id="v4" value=":API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="140" height="840" as="geometry"/></mxCell><mxCell id="v5" value=":PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="140" height="840" as="geometry"/></mxCell><mxCell id="v6" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="575" y="175" width="10" height="755" as="geometry"/></mxCell><mxCell id="e7" value="POST /auth/refresh (refreshToken)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="180" as="sourcePoint"/><mxPoint x="575" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="200" as="sourcePoint"/><mxPoint x="585" y="218" as="targetPoint"/><Array as="points"><mxPoint x="625" y="200"/><mxPoint x="625" y="218"/></Array></mxGeometry></mxCell><mxCell id="v9" value="verificar el JWT: firma, caducidad y tipo «refresh»" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="196" width="300" height="26" as="geometry"/></mxCell><mxCell id="v10" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="245" width="10" height="35" as="geometry"/></mxCell><mxCell id="e11" value="buscar el token por su huella SHA-256" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="250" as="sourcePoint"/><mxPoint x="945" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="fila" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="278" as="sourcePoint"/><mxPoint x="585" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v13" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="980" height="610" as="geometry"/></mxCell><mxCell id="v14" value="[la fila existe, no está anulada ni caducada]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="102" y="328" width="420" height="20" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="345" as="sourcePoint"/><mxPoint x="585" y="363" as="targetPoint"/><Array as="points"><mxPoint x="625" y="345"/><mxPoint x="625" y="363"/></Array></mxGeometry></mxCell><mxCell id="v16" value="firmar el par nuevo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="632" y="341" width="300" height="26" as="geometry"/></mxCell><mxCell id="v17" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="400" width="10" height="50" as="geometry"/></mxCell><mxCell id="e18" value="transacción: anular el actual SOLO si sigue vigente;&lt;br&gt;crear el sucesor en la misma familia y enlazar replacedBy" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="405" as="sourcePoint"/><mxPoint x="945" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="¿se anuló? (filas afectadas)" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="445" as="sourcePoint"/><mxPoint x="585" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v20" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=26;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeColor=#333333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="740" height="200" as="geometry"/></mxCell><mxCell id="v21" value="[esta petición lo anuló]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="312" y="482" width="420" height="20" as="geometry"/></mxCell><mxCell id="e22" value="200 { tokens nuevos }" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="528" as="sourcePoint"/><mxPoint x="215" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e23" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="540" as="sourcePoint"/><mxPoint x="1040" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v24" value="[otra petición con el mismo token se adelantó]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="312" y="556" width="420" height="20" as="geometry"/></mxCell><mxCell id="v25" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="580" width="10" height="35" as="geometry"/></mxCell><mxCell id="e26" value="anular toda la familia (posible robo)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="585" as="sourcePoint"/><mxPoint x="945" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e27" value="401" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="640" as="sourcePoint"/><mxPoint x="215" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="680" as="sourcePoint"/><mxPoint x="1070" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v29" value="[la fila está anulada y tiene sucesor: es una REUTILIZACIÓN]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="102" y="696" width="420" height="20" as="geometry"/></mxCell><mxCell id="v30" value="" style="html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="945" y="730" width="10" height="35" as="geometry"/></mxCell><mxCell id="e31" value="anular toda la familia: el atacante y el cliente legítimo pierden esa sesión" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="735" as="sourcePoint"/><mxPoint x="945" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e32" value="401" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="790" as="sourcePoint"/><mxPoint x="215" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="820" as="sourcePoint"/><mxPoint x="1070" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="[no existe la fila, o cerrada, o caducada]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="102" y="836" width="420" height="20" as="geometry"/></mxCell><mxCell id="e35" value="401 (mismo cuerpo en todos los rechazos)" style="endArrow=open;endSize=8;dashed=1;html=1;verticalAlign=bottom;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="880" as="sourcePoint"/><mxPoint x="215" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v36" value="&lt;b&gt;Por qué así&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Rotación&lt;/b&gt;: cada renovación anula el token usado y entrega otro; un token de refresco solo sirve una vez.&lt;br&gt;• &lt;b&gt;Reutilización = posible robo&lt;/b&gt;: si alguien presenta un token ya renovado, una de las dos partes (el cliente legítimo o un atacante) tiene una copia. No se sabe cuál, así que se anula la &lt;b&gt;familia&lt;/b&gt; entera, y solo ella: las sesiones del usuario en otros dispositivos siguen vivas (decisión del autor del 10-10-2026).&lt;br&gt;• &lt;b&gt;Dos renovaciones a la vez&lt;/b&gt; con el mismo token: la anulación es condicional dentro de la transacción, así que solo una puede ganar; la otra se trata como reutilización.&lt;br&gt;• &lt;b&gt;Mismo 401&lt;/b&gt; en todos los rechazos: la respuesta no dice si el token caducó, se cerró o se reutilizó." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="460" height="330" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Marco &lt;b&gt;alt&lt;/b&gt; = alternativas: se ejecuta solo el tramo cuya &lt;b&gt;[condición]&lt;/b&gt; se cumple; las líneas discontinuas separan los tramos.&lt;br&gt;• Un &lt;b&gt;alt&lt;/b&gt; dentro de otro = una decisión dentro de un caso.&lt;br&gt;• El resto de la notación, como en la página 2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="460" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4Despliegue" name="4. Despliegue"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de despliegue UML 2.5: dónde se ejecuta cada pieza" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;Portátil del autor&lt;/b&gt; (Windows 11)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="380" as="geometry"/></mxCell><mxCell id="v3" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Node.js 24.21&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="100" as="geometry"/></mxCell><mxCell id="v4" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;apps/api&lt;/b&gt; (API en desarrollo, &lt;i&gt;pnpm dev&lt;/i&gt;, puerto 3001)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="205" width="310" height="45" as="geometry"/></mxCell><mxCell id="v5" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Docker Desktop&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="360" height="175" as="geometry"/></mxCell><mxCell id="v6" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;PostgreSQL 16.15&lt;/b&gt; (contenedor &lt;i&gt;bukit-db&lt;/i&gt;)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="320" height="110" as="geometry"/></mxCell><mxCell id="v7" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;base bukit&lt;/b&gt; (PostGIS 3.3.10, pgvector 0.8.0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="280" height="45" as="geometry"/></mxCell><mxCell id="e8" value="&amp;laquo;TCP&amp;raquo;" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.889;exitY=1;entryX=0.938;entryY=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;GitHub&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="360" height="380" as="geometry"/></mxCell><mxCell id="v10" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;repositorio bukit&lt;/b&gt; (rama main)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="300" height="45" as="geometry"/></mxCell><mxCell id="v11" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;GitHub Actions&lt;/b&gt; (runner Ubuntu)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="320" height="160" as="geometry"/></mxCell><mxCell id="v12" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;(lint, typecheck, pruebas, docker, migraciones)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="260" width="280" height="60" as="geometry"/></mxCell><mxCell id="v13" value="Dependabot propone aquí, cada semana, PRs de actualización." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="320" height="40" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Render&lt;/b&gt; (Fráncfort, plan gratuito)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="400" height="200" as="geometry"/></mxCell><mxCell id="v15" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;Contenedor Docker&lt;/b&gt; (node:24.21-alpine)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="145" width="360" height="125" as="geometry"/></mxCell><mxCell id="v16" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;imagen bukit-api&lt;/b&gt; (apps/api)&lt;br&gt;https://bukit-api-07ph.onrender.com" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="195" width="310" height="60" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Neon&lt;/b&gt; (Fráncfort, plan gratuito)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="400" height="180" as="geometry"/></mxCell><mxCell id="v18" value="&amp;laquo;executionEnvironment&amp;raquo;&lt;br&gt;&lt;b&gt;PostgreSQL 16.15&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1020" y="415" width="360" height="105" as="geometry"/></mxCell><mxCell id="v19" value="&amp;laquo;artifact&amp;raquo;&lt;br&gt;&lt;b&gt;base bukit&lt;/b&gt; (PostGIS 3.3.10, pgvector 0.8.0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="460" width="310" height="45" as="geometry"/></mxCell><mxCell id="v20" value="&amp;laquo;device&amp;raquo;&lt;br&gt;&lt;b&gt;Dispositivo del usuario&lt;/b&gt;&lt;br&gt;(hoy, cualquier cliente HTTP; más adelante, navegador y app)" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=14;shape=cube;size=12;direction=south;anchorPointDirection=0;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1500" y="100" width="200" height="150" as="geometry"/></mxCell><mxCell id="e21" value="&amp;laquo;HTTPS&amp;raquo;&lt;br&gt;git push" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" parent="1" source="v2" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="&amp;laquo;HTTPS&amp;raquo;&lt;br&gt;commits y&lt;br&gt;estado de la CI" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.38;" edge="1" parent="1" source="v9" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="&amp;laquo;TCP/TLS&amp;raquo;&lt;br&gt;job&lt;br&gt;migraciones" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.294;" edge="1" parent="1" source="v9" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="&amp;laquo;TCP/TLS&amp;raquo; consultas" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v14" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="&amp;laquo;HTTPS&amp;raquo;" style="endArrow=none;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.425;" edge="1" parent="1" source="v20" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v26" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Cubo = &lt;b&gt;nodo&lt;/b&gt;: una máquina o un servicio donde se ejecuta algo. &amp;laquo;device&amp;raquo; = dispositivo físico; &amp;laquo;executionEnvironment&amp;raquo; = entorno de ejecución dentro de un nodo.&lt;br&gt;• &amp;laquo;artifact&amp;raquo; = pieza concreta que se despliega (una imagen, una base, un archivo).&lt;br&gt;• Línea entre nodos = &lt;b&gt;ruta de comunicación&lt;/b&gt;, con su protocolo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Más adelante&lt;/b&gt; se añadirán nodos para la web (Vercel o Cloudflare Pages), el móvil (Expo/EAS) y los servicios externos (mensajería, imágenes, notificaciones push, verificación de identidad, IA, Redis)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="860" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5Actividaddeunpushaproduccin" name="5. Actividad: de un push a producción"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de actividad UML 2.5: cómo llega un cambio a producción" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Autor" style="swimlane;horizontal=1;startSize=30;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="820" as="geometry"/></mxCell><mxCell id="v3" value="GitHub Actions (CI)" style="swimlane;horizontal=1;startSize=30;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFil