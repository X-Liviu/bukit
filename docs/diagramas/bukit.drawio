ackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v8" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="[algún paso falló]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="[todo en verde]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="[es una PR]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="[es un push a main]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v35" value="La CI queda en rojo: no se migra ni se despliega." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="868" y="555" width="108" height="50" as="geometry"/></mxCell><mxCell id="v36" value="La PR queda lista para revisarla y fusionarla." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="868" y="645" width="108" height="50" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;: ● = inicio; ◉ = fin. Rectángulo redondeado = &lt;b&gt;acción&lt;/b&gt;. Barra negra = &lt;b&gt;bifurcación&lt;/b&gt; (lo que sale de ella va en paralelo) y &lt;b&gt;unión&lt;/b&gt; (espera a todo lo que entra). Rombo = &lt;b&gt;decisión&lt;/b&gt;, con sus condiciones entre corchetes. Cada calle indica quién ejecuta la acción.&lt;br&gt;Simplificación: si el lint falla, no se ejecuta nada más; en una PR, un push nuevo cancela la ejecución anterior; en main, las ejecuciones esperan turno para no cortar una migración a medias." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1240" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5Paquetesmonorepo" name="5. Paquetes: monorepo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de paquetes UML 2.5: las piezas del repositorio y de qué depende cada una" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="bukit (monorepo pnpm)" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="600" as="geometry"/></mxCell><mxCell id="v3" value="apps" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="760" height="220" as="geometry"/></mxCell><mxCell id="v4" value="packages" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;sp