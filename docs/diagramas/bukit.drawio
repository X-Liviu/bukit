t&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;cliente HTTP tipado&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="190" height="120" as="geometry"/></mxCell><mxCell id="v10" value="ui-core&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;lógica de interfaz compartida&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="200" height="120" as="geometry"/></mxCell><mxCell id="v11" value="e2e&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pruebas en navegador (Playwright)&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="120" as="geometry"/></mxCell><mxCell id="e12" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v5" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v9" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v10" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="620"/><mxPoint x="195" y="620"/></Array></mxGeometry></mxCell><mxCell id="e15" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;exitX=0.85;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="v11" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="165"/><mxPoint x="465" y="165"/></Array></mxGeometry></mxCell><mxCell id="v19" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Carpeta = &lt;b&gt;paquete&lt;/b&gt; (un conjunto de código).&lt;br&gt;• Flecha discontinua &amp;laquo;use&amp;raquo; = &lt;b&gt;dependencia&lt;/b&gt;: el de origen usa al de destino.&lt;br&gt;• Verde = tiene código · amarillo = esqueleto (solo estructura) · gris discontinuo = vacío (solo README) · flecha gris = dependencia futura.&lt;br&gt;&lt;br&gt;Fuera de los paquetes de código: &lt;i&gt;docker/postgres&lt;/i&gt; (la imagen de la base) y &lt;i&gt;docs/&lt;/i&gt; (memoria, diario y estos diagramas)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="880" y="410" width="320" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
