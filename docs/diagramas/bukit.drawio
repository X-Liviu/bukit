keColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="220" height="60" as="geometry"/></mxCell><mxCell id="v12" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="450" y="520" width="420" height="6" as="geometry"/></mxCell><mxCell id="v13" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="40" height="40" as="geometry"/></mxCell><mxCell id="v14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="565" width="30" height="30" as="geometry"/></mxCell><mxCell id="v15" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="650" width="40" height="40" as="geometry"/></mxCell><mxCell id="v16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="655" width="30" height="30" as="geometry"/></mxCell><mxCell id="v17" value="Aplicar las migraciones en Neon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="200" height="50" as="geometry"/></mxCell><mxCell id="v18" value="Desplegar la API nueva&lt;br&gt;(solo con TODO en verde)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1020" y="740" width="220" height="50" as="geometry"/></mxCell><mxCell id="v19" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="835" width="30" height="30" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v8" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="[algún paso falló]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="[todo en verde]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="[es una PR]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="[es un push a main]" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="endArrow=open;endSize=10;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v35" value="La CI queda en rojo: no se migra ni se despliega." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="868" y="555" width="108" height="50" as="geometry"/></mxCell><mxCell id="v36" value="La PR queda lista para revisarla y fusionarla." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="868" y="645" width="108" height="50" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;: ● = inicio; ◉ = fin. Rectángulo redondeado = &lt;b&gt;acción&lt;/b&gt;. Barra negra = &lt;b&gt;bifurcación&lt;/b&gt; (lo que sale de ella va en paralelo) y &lt;b&gt;unión&lt;/b&gt; (espera a todo lo que entra). Rombo = &lt;b&gt;decisión&lt;/b&gt;, con sus condiciones entre corchetes. Cada calle indica quién ejecuta la acción.&lt;br&gt;Simplificación: si el lint falla, no se ejecuta nada más; en una PR, un push nuevo cancela la ejecución anterior; en main no se cancela la que está en curso (podría cortar una migración a medias) y, si se acumulan varias en espera, GitHub solo conserva la más reciente." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1240" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6Paquetesmonorepo" name="6. Paquetes: monorepo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Diagrama de paquetes UML 2.5: las piezas del repositorio y de qué depende cada una" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="v2" value="bukit (monorepo pnpm)" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="600" as="geometry"/></mxCell><mxCell id="v3" value="apps" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="760" height="220" as="geometry"/></mxCell><mxCell id="v4" value="packages" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="760" height="230" as="geometry"/></mxCell><mxCell id="v5" value="api&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;Express 5 + Prisma 6: la API REST&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="v6" value="web&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;React + Vite (llega en F2)&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="190" width="190" height="120" as="geometry"/></mxCell><mxCell id="v7" value="mobile&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;React Native + Expo (secundario)&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="190" width="200" height="120" as="geometry"/></mxCell><mxCell id="v8" value="core&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;esquemas Zod y tipos compartidos&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="190" height="120" as="geometry"/></mxCell><mxCell id="v9" value="api-client&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;cliente HTTP tipado&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="190" height="120" as="geometry"/></mxCell><mxCell id="v10" value="ui-core&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;lógica de interfaz compartida&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="200" height="120" as="geometry"/></mxCell><mxCell id="v11" value="e2e&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pruebas en navegador (Playwright)&lt;/span&gt;" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="260" height="120" as="geometry"/></mxCell><mxCell id="e12" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v5" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v9" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v10" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="620"/><mxPoint x="195" y="620"/></Array></mxGeometry></mxCell><mxCell id="e15" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;exitX=0.85;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="&amp;laquo;use&amp;raquo;" style="endArrow=open;endSize=12;dashed=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;fontColor=#777777;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="v11" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="165"/><mxPoint x="465" y="165"/></Array></mxGeometry></mxCell><mxCell id="v19" value="&lt;b&gt;Cómo se lee (UML 2.5)&lt;/b&gt;&lt;br&gt;• Carpeta = &lt;b&gt;paquete&lt;/b&gt; (un conjunto de código).&lt;br&gt;• Flecha discontinua &amp;laquo;use&amp;raquo; = &lt;b&gt;dependencia&lt;/b&gt;: el de origen usa al de destino.&lt;br&gt;• Verde = tiene código · amarillo = esqueleto (solo estructura) · gris discontinuo = vacío (solo README) · flecha gris = dependencia futura.&lt;br&gt;&lt;br&gt;Fuera de los paquetes de código: &lt;i&gt;docker/postgres&lt;/i&gt; (la imagen de la base) y &lt;i&gt;docs/&lt;/i&gt; (memoria, diario y estos diagramas)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="880" y="410" width="320" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
