{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // === Formateo automático con Prettier al guardar ===
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // === ESLint: autofix al guardar (config plana) ===
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // === TypeScript: usar la versión del repo, no la de VS Code ===
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // === Error Lens: errores/avisos en línea ===
  "errorLens.enabled": true,
  "errorLens.delay": 300,
  "errorLens.gutterIconsEnabled": true,

  // === LaTeX Workshop: artefactos de compilación a build/ (coherente con .latexmkrc) ===
  "latex-workshop.latex.outDir": "%DIR%/build",
  // La primera receta es la que se usa al guardar. latexmk (la herramienta
  // estándar) requiere Perl instalado; en la máquina del autor (MiKTeX sin Perl), la receta manual
  // pdflatex+biber hace lo mismo sin Perl.
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "--enable-installer",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      // biber condicional (29-07-2026): solo corre si el documento generó un
      // .bcf (es decir, usa biblatex). Los documentos independientes de
      // riesgos (docs/thesis/plan-riesgos/ y seguimiento-riesgos/) no tienen
      // bibliografía y biber fallaba en vacío ("Cannot find .bcf") en cada
      // guardado; con este guard la MISMA receta sirve para la memoria y
      // para ellos, sin elegir receta a mano.
      "name": "biber",
      "command": "cmd",
      "args": [
        "/c",
        "if exist %OUTDIR%/%DOCFILE%.bcf (biber %OUTDIR%/%DOCFILE%) else (echo Documento sin biblatex: no hay .bcf y se omite biber)"
      ]
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex + biber + pdflatex × 2 (sin Perl)",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    },
    { "name": "latexmk (requiere Perl)", "tools": ["latexmk"] }
  ],
  // Usar siempre la primera receta (la de sin Perl) al compilar.
  "latex-workshop.latex.recipe.default": "first",
  // Recompilar automáticamente al guardar cualquier .tex del proyecto.
  // LaTeX Workshop detecta que main.tex es la raíz (tiene \documentclass) y lo
  // compila aunque guardes un capítulo suelto de chapters/, así que el PDF
  // main.pdf se actualiza edites el archivo que edites.
  "latex-workshop.latex.autoBuild.run": "onSave",
  // Abrir/actualizar el PDF en una pestaña de VS Code (no en navegador externo).
  "latex-workshop.view.pdf.viewer": "tab",
  // No borrar los .aux/.bcf entre compilaciones: biber los necesita para las citas.
  "latex-workshop.latex.autoClean.run": "never",

  // === Menos ruido en la búsqueda ===
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true
  },
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  }
}
