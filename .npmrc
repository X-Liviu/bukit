# Fijar versiones exactas al hacer `pnpm add` (reproducibilidad).
# La reproducibilidad real la garantiza pnpm-lock.yaml (commiteado).
save-exact=true

# Cumplir el campo "engines" del package.json (avisa si la versión de Node no encaja).
engine-strict=true

# --- React Native / Expo ---
# Metro históricamente se llevaba mal con los symlinks de pnpm. Si al montar
# apps/mobile diera guerra, descomenta la línea siguiente para un node_modules
# plano estilo npm (conserva el store rápido de pnpm):
# node-linker=hoisted
